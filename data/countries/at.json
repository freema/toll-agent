  "rules": [
    {
      "id": "at-18-day-rule",
      "severity": "warning",
      "text": {
        "en": "2-month and annual digital vignettes bought online by a consumer are valid at the earliest from the 18th day after purchase (14-day statutory right of withdrawal). 1-day and 10-day vignettes are valid immediately. Buying at a petrol station, ÖAMTC, ARBÖ or ADAC is not distance selling and is valid immediately.",
        "cs": "Dvouměsíční a roční digitální známka koupená online spotřebitelem platí nejdříve od 18. dne po nákupu (zákonná 14denní lhůta na odstoupení). Jednodenní a desetidenní platí okamžitě. Nákup na benzínce, u ÖAMTC, ARBÖ nebo ADAC není zásilkový obchod a platí hned."
      },
      "quote": "2-Monats- und Jahres-Vignetten sind aufgrund des Konsumentenschutzes auch weiterhin frühestens ab dem 18. Tag nach dem Online-Kauf gültig.",
      "effect": "delays-validity",
      "source": "https://www.asfinag.at/maut-vignette/vignette/",
      "verifiedAt": "2026-09-03"
    },
    {
      "id": "at-section-toll-separate",
      "severity": "warning",
      "text": {
        "en": "Section tolls (Karawanken, Tauern, Brenner, Arlberg, Bosruck, Gleinalm) are not covered by the vignette and are paid separately. A digital section-toll ticket bought online is subject to the same 18-day rule.",
        "cs": "Úsekové mýto (Karawanken, Tauern, Brenner, Arlberg, Bosruck, Gleinalm) známka nepokrývá, platí se zvlášť. Digitální úsekové mýto koupené online podléhá stejné 18denní lhůtě."
      },
      "effect": "extra-cost",
      "source": "https://www.asfinag.at/maut-vignette/streckenmaut/",
      "verifiedAt": "2026-09-03"
    },
    {
      "id": "at-sticker-ends-2027",
      "severity": "info",
      "text": {
        "en": "The 2026 vignette year is the last one with a physical sticker. From 1 February 2027 Austria is digital only, which removes the 'buy it at a petrol station and drive now' escape hatch from the 18-day rule.",
        "cs": "Rok 2026 je poslední s nálepkou. Od 1. února 2027 jede Rakousko jen digitálně, čímž zmizí únikový východ z 18denní lhůty přes nákup na benzínce."
      },
      "effect": "roadmap",
      "source": "https://www.asfinag.at/ueber-uns/presse/pressemeldungen/klebevignette-2026-wird-feuerrot/",
      "verifiedAt": "2026-09-03"
    },
    {
      "id": "at-sells-si-vignette",
      "severity": "info",
      "text": {
        "en": "ASFINAG is an authorised DARS partner and sells the Slovenian e-vinjeta at face value — useful when you need both, but DARS itself remains the primary source.",
        "cs": "ASFINAG je autorizovaný partner DARS a prodává slovinskou e-vinjetu bez přirážky — užitečné, když potřebuješ obojí, primárním zdrojem ale zůstává DARS."
      },
      "effect": "alternative-source",
      "source": "https://shop.asfinag.at/en/products/slovenian-e-vignette/",
      "verifiedAt": "2026-09-03"
    },
