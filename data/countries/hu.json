      "verifiedAt": "2026-09-03"
    },
    {
      "id": "hu-county-structure",
      "severity": "warning",
      "text": {
        "en": "Hungary also sells annual county (varmegyei) vignettes. One is needed per county the route crosses, so a transit trip can need several — compare the total against the national annual before buying.",
        "cs": "Maďarsko prodává i roční župní (vármegyei) známky. Potřebuješ jednu na každou župu, kterou trasa protne, takže tranzit může vyjít na několik — před nákupem porovnej součet s celostátní roční."
      },
      "effect": "alternative-product",
      "source": "https://nemzetiutdij.hu/api/uploads/e_matrica_arak_2026_pdf_611db0ecc1.pdf",
      "verifiedAt": "2026-09-03"
    },
    {
      "id": "hu-year-cannot-be-corrected",
      "severity": "warning",
      "text": {
        "en": "The year of validity is chosen at purchase and cannot be corrected afterwards. Check it before paying.",
        "cs": "Rok platnosti se vybírá při nákupu a už ho nejde opravit. Zkontroluj ho před zaplacením."
      },
      "effect": "verify-before-purchase",
      "source": "https://nemzetiutdij.hu",
      "verifiedAt": "2026-09-03"
    },
    {
      "id": "hu-penalty",
      "severity": "info",
      "text": {
        "en": "Driving without a valid e-matrica costs 27 790 HUF if paid within 60 days, 95 730 HUF after that (2026 rates).",
        "cs": "Jízda bez platné e-matricy stojí 27 790 HUF při zaplacení do 60 dnů, po nich 95 730 HUF (sazby 2026)."
      },
      "effect": "penalty",
      "source": "https://nemzetiutdij.hu/api/uploads/e_matrica_arak_2026_pdf_611db0ecc1.pdf",
      "verifiedAt": "2026-09-03"
    },
    {
      "id": "hu-above-3500",
      "severity": "blocking",
      "text": {
        "en": "Vehicles over 3.5 t use HU-GO distance-based tolling, not an e-matrica. Out of scope for this tool.",
        "cs": "Vozidla nad 3,5 t platí výkonové mýto HU-GO, ne e-matricu. Mimo rozsah tohoto nástroje."
