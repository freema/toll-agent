  "rules": [
    {
      "id": "si-class-by-height",
      "severity": "warning",
      "text": {
        "en": "The Slovenian class is decided by the height above the FIRST axle, not by the vehicle's total height or its weight. 1.3 m is the boundary between 2A and 2B, and 2B costs exactly twice as much. Many vans and camper conversions fall into 2B.",
        "cs": "Slovinskou třídu určuje výška nad PŘEDNÍ nápravou, ne celková výška ani hmotnost. Hranice 2A/2B je 1,3 m a 2B stojí přesně dvojnásobek. Spousta dodávek a obytných vestaveb spadá do 2B."
      },
      "effect": "class-critical",
      "source": "https://evinjeta.dars.si",
      "verifiedAt": "2026-09-03"
    },
    {
      "id": "si-immediate-validity",
      "severity": "info",
      "text": {
        "en": "The e-vinjeta can be valid immediately — there is no Austrian-style 18-day delay. It can also be bought in advance with a chosen start date.",
        "cs": "E-vinjeta může platit okamžitě — žádná obdoba rakouské 18denní lhůty tu není. Jde ji koupit i dopředu s vybraným začátkem platnosti."
      },
      "effect": "timing",
      "source": "https://evinjeta.dars.si",
      "verifiedAt": "2026-09-03"
    },
    {
      "id": "si-authorised-resellers",
      "severity": "info",
      "text": {
        "en": "DARS authorises a few resellers (ASFINAG, Petrol, ADAC) that sell at face value. Anything else selling a Slovenian e-vinjeta online is not authorised.",
        "cs": "DARS autorizuje několik prodejců (ASFINAG, Petrol, ADAC), kteří prodávají bez přirážky. Cokoli jiného, co prodává slovinskou e-vinjetu online, autorizované není."
      },
      "effect": "alternative-source",
