{
  "name": "toll-agent",
  "version": "0.1.0",
  "description": "Tells you which European road tolls your trip needs, checks what you already have, and sends you to the official state e-shop to buy it. No resale, no markup, no payment handling.",
  "keywords": [
    "toll",
    "vignette",
    "mcp",
    "mcp-server",
    "dalnicni-znamka",
    "vignette-europe",
    "asfinag",
    "edalnice",
    "dars",
    "travel"
  ],
  "license": "MIT",
  "author": "Tomas Grasl",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freema/toll-agent.git"
  },
  "bugs": {
    "url": "https://github.com/freema/toll-agent/issues"
  },
  "homepage": "https://github.com/freema/toll-agent#readme",
  "type": "module",
  "engines": {
    "node": ">=20.10"
  },
  "bin": {
    "toll-agent": "dist/cli/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "data",
    "README.md",
    "README.cs.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cli": "tsx src/cli/cli.ts",
    "mcp": "tsx src/mcp/server.ts",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^9.15.0",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.16.0",
    "vitest": "^4.1.12"
  }
}
